
import { Router } from "express";
import { z } from "zod";
import { prisma } from "../db.js";
import { requireAuth } from "../middleware/auth.js";

const router = Router();

router.use(requireAuth);

// GET MY PROFILE
router.get("/me", async (req, res) => {
  try {
    const user = await prisma.user.findUnique({
      where: { id: req.user.id },
      select: {
        id: true,
        username: true,
        role: true,
        profileImage: true
      }
    });

    return res.json({ user });
  } catch (error) {
    console.error(error);
    return res.status(500).json({
      error: "Could not load profile"
    });
  }
});

// UPDATE MY PROFILE IMAGE
router.patch("/me/image", async (req, res) => {
  const schema = z.object({
    profileImage: z.string().url().max(2048)
  });

  const parsed = schema.safeParse(req.body);

  if (!parsed.success) {
    return res.status(400).json({
      error: "Please provide a valid image URL"
    });
  }

  if (!["TIPSTER", "SUPER_ADMIN"].includes(req.user.role)) {
    return res.status(403).json({
      error: "Only Tipsters can update profile images"
    });
  }

  try {
    const user = await prisma.user.update({
      where: { id: req.user.id },
      data: {
        profileImage: parsed.data.profileImage
      },
      select: {
        id: true,
        username: true,
        role: true,
        profileImage: true
      }
    });

    return res.json({
      message: "Profile image updated successfully",
      user
    });
  } catch (error) {
    console.error(error);
    return res.status(500).json({
      error: "Could not update profile image"
    });
  }
});

export default router;
