
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tipster Profile | 4U'S TIPS</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#071b15;color:white}
header{background:#063b2b;border-bottom:2px solid #d4af37;padding:18px;text-align:center}
h1,h2,h3{color:#d4af37}
main{max-width:650px;margin:auto;padding:18px}
.panel{background:#102a21;border:1px solid #315644;border-radius:12px;padding:18px;margin-bottom:18px}
button{width:100%;padding:13px;margin:7px 0;border-radius:7px;font-size:15px;border:0;background:#d4af37;color:#102a21;font-weight:bold;cursor:pointer}
.secondary{background:#063b2b;color:white;border:1px solid #d4af37}
.avatar{width:110px;height:110px;border-radius:50%;object-fit:cover;border:3px solid #d4af37}
.profile{text-align:center}
.stats{color:#d4af37}
.tip{background:#071b15;border:1px solid #315644;border-radius:9px;padding:13px;margin:10px 0}
.message{color:#d4af37}
.locked{border:1px solid #d4af37;background:#18251e}
.lock-label{color:#d4af37;font-weight:bold}
.premium-title{color:#d4af37}
.free-title{color:#35d39a}
.result{font-weight:bold;color:#d4af37}
.expiry{color:#aaa;font-size:13px}
</style>
</head>

<body>

<header>
<h1>4U'S TIPS</h1>
<p>PREDICT SMARTER</p>
</header>

<main>

<div class="panel">
<button class="secondary" onclick="goBack()">← Back to Tipsters</button>
</div>

<div class="panel profile" id="profile">
<p class="message">Loading Tipster profile...</p>
</div>

<div class="panel">
<h2 class="free-title">FREE TIPS</h2>
<div id="freeTips">Loading FREE tips...</div>
</div>

<div class="panel">
<h2 class="premium-title">PREMIUM TIPS 🔒</h2>
<div id="premiumTips">Loading PREMIUM tips...</div>
</div>

<div class="panel">
<h2 class="free-title">FREE BOOKING SLIPS</h2>
<div id="freeSlips">Loading FREE slips...</div>
</div>

<div class="panel">
<h2 class="premium-title">PREMIUM BOOKING SLIPS 🔒</h2>
<div id="premiumSlips">Loading PREMIUM slips...</div>
</div>

</main>

<script>
const API=window.location.origin;
const params=new URLSearchParams(window.location.search);
const tipsterId=params.get("id");
let token="";

async function request(path){
 const response=await fetch(API+path,{
  headers:{
   "Authorization":"Bearer "+token
  }
 });

 const data=await response.json();

 if(!response.ok){
  throw new Error(data.message||data.error||"Request failed");
 }

 return data;
}

function goBack(){
 window.location.href="index.html";
}

function showError(message){
 document.getElementById("profile").textContent=message;
 document.getElementById("freeTips").textContent=message;
 document.getElementById("premiumTips").textContent=message;
 document.getElementById("freeSlips").textContent=message;
 document.getElementById("premiumSlips").textContent=message;
}

function addText(parent,label,value){
 const p=document.createElement("p");
 p.textContent=label+": "+value;
 parent.appendChild(p);
}

function createFreeTip(tip){
 const card=document.createElement("div");
 card.className="tip";

 const match=document.createElement("h3");
 match.textContent=tip.matchName||"Match";

 addText(card,"Prediction",tip.prediction||"Not available");
 addText(card,"Odds",tip.odds??"Not set");

 const result=document.createElement("p");
 result.className="result";
 result.textContent="Result: "+(tip.result||"PENDING");

 card.append(match,result);

 if(tip.validityUntil){
  addText(card,"Expires",new Date(tip.validityUntil).toLocaleString());
 }

 return card;
}

function createPremiumTip(tip){
 const card=document.createElement("div");
 card.className="tip locked";

 const label=document.createElement("p");
 label.className="lock-label";
 label.textContent="🔒 PREMIUM LOCKED";

 const match=document.createElement("h3");
 match.textContent=tip.matchName||"Premium Match";

 const info=document.createElement("p");
 info.textContent="This is an exclusive Premium tip.";

 const hidden=document.createElement("p");
 hidden.textContent="Prediction: 🔒 Hidden";

 const odds=document.createElement("p");
 odds.textContent="Odds: 🔒 Hidden";

 const button=document.createElement("button");
 button.textContent="PREMIUM ACCESS COMING SOON";
 button.disabled=true;
 button.style.opacity="0.7";

 card.append(label,match,info,hidden,odds,button);
 return card;
}

function createFreeSlip(slip){
 const card=document.createElement("div");
 card.className="tip";

 const title=document.createElement("h3");
 title.textContent=slip.title||"Booking Slip";

 card.appendChild(title);

 addText(card,"Total Odds",slip.totalOdds??"Not set");
 addText(card,"Risk",slip.riskLabel||"Not set");

 const result=document.createElement("p");
 result.className="result";
 result.textContent="Result: "+(slip.result||"PENDING");
 card.appendChild(result);

 if(slip.validityUntil){
  addText(card,"Expires",new Date(slip.validityUntil).toLocaleString());
 }

 (slip.bookingCodes||[]).forEach(code=>{
  addText(card,code.bookmaker||"Booking Code",code.code||"");
 });

 return card;
}

function createPremiumSlip(slip){
 const card=document.createElement("div");
 card.className="tip locked";

 const label=document.createElement("p");
 label.className="lock-label";
 label.textContent="🔒 PREMIUM LOCKED";

 const title=document.createElement("h3");
 title.textContent=slip.title||"Premium Booking Slip";

 const info=document.createElement("p");
 info.textContent="This is an exclusive Premium booking slip.";

 const button=document.createElement("button");
 button.textContent="PREMIUM ACCESS COMING SOON";
 button.disabled=true;
 button.style.opacity="0.7";

 card.append(label,title,info,button);
 return card;
}

async function changeFollow(isFollowing){
 try{
  const response=await fetch(
   API+"/api/follows/"+encodeURIComponent(tipsterId),
   {
    method:isFollowing?"DELETE":"POST",
    headers:{
     "Authorization":"Bearer "+token
    }
   }
  );

  const data=await response.json();

  if(!response.ok){
   throw new Error(data.error||"Follow action failed");
  }

  await loadProfile();

 }catch(error){
  alert(error.message);
 }
}

async function loadProfile(){
 try{
  if(!tipsterId){
   throw new Error("Tipster ID haipo kwenye link.");
  }

  const savedToken=sessionStorage.getItem("4u_customer_token");

  if(!savedToken){
   throw new Error("Tafadhali login kwanza kupitia Customer Website.");
  }

  token=savedToken;

  const me=await request("/api/auth/me");

  if(me.user.role!=="CUSTOMER"){
   throw new Error("Tumia akaunti ya Customer.");
  }

  const result=await request(
   "/api/tipsters/"+encodeURIComponent(tipsterId)
  );

  // API yako inarudisha profile moja kwa moja.
  const t=result.tipster||result;

  if(!t || !t.id){
   throw new Error("Tipster profile haijapatikana.");
  }

  const profile=document.getElementById("profile");
  profile.innerHTML="";

  const img=document.createElement("img");
  img.className="avatar";
  img.src=t.profileImage||
   "https://placehold.co/120x120/063b2b/d4af37?text=4U";

  img.onerror=()=>{
   img.src="https://placehold.co/120x120/063b2b/d4af37?text=4U";
  };

  const name=document.createElement("h2");
  name.textContent=t.username;

  const followers=document.createElement("p");
  followers.className="stats";
  followers.textContent="Followers: "+
   (t.followersCount??t.followers??0);

  const stats=t.stats||{};

  const accuracy=document.createElement("h3");
  accuracy.textContent="Winning Accuracy: "+
   (stats.accuracy??t.accuracy??0)+"%";

  const record=document.createElement("p");
  record.textContent="Wins: "+
   (stats.wins??t.wins??0)+" | Losses: "+
   (stats.losses??t.losses??0);

  const follow=document.createElement("button");
  follow.textContent=t.isFollowing?"Unfollow":"Follow";
  follow.onclick=()=>changeFollow(!!t.isFollowing);

  profile.append(img,name,followers,accuracy,record,follow);

  const now=Date.now();

  // Customer anaonyeshwa tips ambazo muda wake haujaisha.
  const tips=(t.tips||[]).filter(tip=>
   !tip.validityUntil ||
   new Date(tip.validityUntil).getTime()>now
  );

  const freeTips=tips.filter(tip=>tip.category==="FREE");
  const premiumTips=tips.filter(tip=>tip.category==="PREMIUM");

  const slips=(t.slips||[]).filter(slip=>
   slip.isPublished!==false &&
   slip.validityUntil &&
   new Date(slip.validityUntil).getTime()>now
  );

  const freeSlips=slips.filter(slip=>slip.category==="FREE");
  const premiumSlips=slips.filter(slip=>slip.category==="PREMIUM");

  const freeList=document.getElementById("freeTips");
  const premiumList=document.getElementById("premiumTips");
  const freeSlipList=document.getElementById("freeSlips");
  const premiumSlipList=document.getElementById("premiumSlips");

  freeList.innerHTML="";
  premiumList.innerHTML="";
  freeSlipList.innerHTML="";
  premiumSlipList.innerHTML="";

  if(!freeTips.length){
   freeList.textContent="Hakuna FREE tips zinazoendelea kwa sasa.";
  }else{
   freeTips.forEach(tip=>
    freeList.appendChild(createFreeTip(tip))
   );
  }

  if(!premiumTips.length){
   premiumList.textContent="Hakuna PREMIUM tips zinazoendelea kwa sasa.";
  }else{
   premiumTips.forEach(tip=>
    premiumList.appendChild(createPremiumTip(tip))
   );
  }

  if(!freeSlips.length){
   freeSlipList.textContent="Hakuna FREE slips zinazoendelea kwa sasa.";
  }else{
   freeSlips.forEach(slip=>
    freeSlipList.appendChild(createFreeSlip(slip))
   );
  }

  if(!premiumSlips.length){
   premiumSlipList.textContent="Hakuna PREMIUM slips zinazoendelea kwa sasa.";
  }else{
   premiumSlips.forEach(slip=>
    premiumSlipList.appendChild(createPremiumSlip(slip))
   );
  }

 }catch(error){
  showError(error.message);
 }
}

loadProfile();
</script>

</body>
</html>
