
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  TIPSTER
  CUSTOMER
}

enum TipCategory {
  FREE
  PREMIUM
}

enum TipResult {
  PENDING
  WON
  LOST
  VOID
}

enum Bookmaker {
  SPORTYBET
  BETPAWA
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  profileImage String?

  tips         Tip[]
  slips        Slip[]
  following    Follow[] @relation("CustomerFollowing")
  followers    Follow[] @relation("TipsterFollowers")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tip {
  id           String      @id @default(uuid())
  tipsterId    String
  tipster      User        @relation(fields: [tipsterId], references: [id])
  matchName    String
  prediction   String
  odds         Decimal?    @db.Decimal(8, 2)
  category     TipCategory @default(FREE)
  result       TipResult   @default(PENDING)
  kickoffAt    DateTime?
  validityUntil DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tipsterId, createdAt])
  @@index([tipsterId, result])
  @@index([result])
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  tipsterId  String

  follower   User     @relation("CustomerFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  tipster    User     @relation("TipsterFollowers", fields: [tipsterId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([followerId, tipsterId])
  @@index([tipsterId])
}

model Slip {
  id               String        @id @default(uuid())
  tipsterId        String
  tipster          User          @relation(fields: [tipsterId], references: [id], onDelete: Cascade)
  title            String
  riskLabel        String?
  totalOdds        Decimal       @db.Decimal(10, 2)
  price            Decimal       @default(0) @db.Decimal(10, 2)
  category         TipCategory   @default(FREE)
  result           TipResult     @default(PENDING)
  isPublished      Boolean       @default(true)
  validityUntil    DateTime?
  kickoffAt        DateTime?
  kickoffStartedAt DateTime?
  isLocked         Boolean       @default(false)
  bookingCodes     BookingCode[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tipsterId, createdAt])
  @@index([tipsterId, result])
  @@index([category, isPublished])
}

model BookingCode {
  id         String    @id @default(uuid())
  slipId     String
  slip       Slip      @relation(fields: [slipId], references: [id], onDelete: Cascade)
  bookmaker  Bookmaker
  code       String
  createdAt  DateTime  @default(now())

  @@unique([slipId, bookmaker])
  @@index([slipId])
}
